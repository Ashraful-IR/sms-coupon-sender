PORT=3000
# Protects every /api route. Send it as the x-api-key header.
API_KEY=change-me-to-a-long-random-string

# SSL Wireless SMS Plus credentials and gateway endpoints
SSL_API_TOKEN=your-api-token
SSL_SID=your-sid
SSL_BASE_URL=https://smsplus.sslwireless.com
# Optional: override individual endpoints (defaults below)
# SSL_URL=$SSL_BASE_URL/api/v3/send-sms
# SSL_BULK_URL=$SSL_BASE_URL/api/v3/send-sms/bulk
# SSL_DYNAMIC_URL=$SSL_BASE_URL/api/v3/send-sms/dynamic

# Which Push SMS API to send through:
#   single  = /api/v3/send-sms         one SMS per request (slowest, simplest)
#   bulk    = /api/v3/send-sms/bulk    one common body to up to 100 numbers (only batches rows with identical text)
#   dynamic = /api/v3/send-sms/dynamic up to 100 numbers, each with its own text (best for per-recipient coupons)
SMS_MODE=single
# Max MSISDN per bulk/dynamic request. The gateway caps this at 100.
BATCH_SIZE=100

# Placeholders: {contact_no} {outlate_name} {cupon_code} {stage}
SMS_TEMPLATE="প্রিয় ব্রেক কমিউনিটি মেম্বার, {outlate_name} আউটলেটে এসে আপনার {cupon_code} কুপনটি ব্যবহার করে জিতে নিন আকর্ষণীয় পুরস্কার, প্রোগ্রামের সময়সীমা ১০ই অক্টোবর থেকে ১১ই ডিসেম্বর পর্যন্ত। মনে রাখবেন, ব্রেক কমিউনিটির সাথে প্রতি মুহূর্ত জমে যায়, সেরা ব্রেক সবসময়।"

# Throughput. RATE_PER_SECOND counts requests, not SMS: in single mode one request = one SMS,
# in bulk/dynamic mode one request carries up to BATCH_SIZE SMS.
# 200,000 rows at 10 requests/s = about 5.5 hours single, about 3.5 minutes dynamic with BATCH_SIZE=100.
# Ask SSL Wireless what rate and TPS your account allows, then set it here.
RATE_PER_SECOND=10
CONCURRENCY=10

# Halt the job automatically after this many failures in a row (bad token, no balance...)
CONSECUTIVE_FAILURE_LIMIT=25
# Resume a running job automatically after a server restart
AUTO_RESUME=true

MAX_RETRIES=2
REQUEST_TIMEOUT_MS=15000
MAX_UPLOAD_MB=50
DATA_DIR=./data
