PORT=3000
# Protects every /api route. Send it as the x-api-key header.
API_KEY=change-me-to-a-long-random-string

# SSL Wireless SMS Plus credentials
SSL_API_TOKEN=your-api-token
SSL_SID=your-sid
SSL_URL=https://smsplus.sslwireless.com/api/v3/send-sms

# Placeholders: {contact_no} {outlate_name} {cupon_code} {stage}
SMS_TEMPLATE="প্রিয় ব্রেক কমিউনিটি মেম্বার, {outlate_name} আউটলেটে এসে আপনার {cupon_code} কুপনটি ব্যবহার করে জিতে নিন আকর্ষণীয় পুরস্কার, প্রোগ্রামের সময়সীমা ১০ই অক্টোবর থেকে ১১ই ডিসেম্বর পর্যন্ত। মনে রাখবেন, ব্রেক কমিউনিটির সাথে প্রতি মুহূর্ত জমে যায়, সেরা ব্রেক সবসময়।"

# Throughput. 200,000 SMS at 10/s = about 5.5 hours, at 50/s = about 67 minutes.
# Ask SSL Wireless what rate your account allows, then set it here.
RATE_PER_SECOND=10
CONCURRENCY=10

# Halt the job automatically after this many failures in a row (bad token, no balance...)
CONSECUTIVE_FAILURE_LIMIT=25
# Resume a running job automatically after a server restart
AUTO_RESUME=true

MAX_RETRIES=2
REQUEST_TIMEOUT_MS=15000
MAX_UPLOAD_MB=50
DATA_DIR=./data
