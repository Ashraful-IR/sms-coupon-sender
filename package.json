{
  "name": "sms-coupon-sender",
  "version": "1.0.0",
  "description": "Upload a CSV (contact_no, outlate_name, stage) and send campaign SMS via SSL Wireless SMS Plus API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "upload": "node scripts/send.js",
    "send:live": "node scripts/send.js --live"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.0.0"
  }
}
